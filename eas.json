{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "release": {
      "distribution": "internal",
      "environment": "production",
      "env": { "EXPO_NO_DOTENV": "1" },
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "ios": {
        "simulator": false
      }
    }
  }
}
